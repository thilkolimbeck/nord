{
  "name": "nord",
  "version": "0.1.0",
  "private": true,
  "description": "A browser editor and synth for Nord Stage 4 programs",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "gen": "python3 -I ../tools/gen_layouts.py \"${OPENNORD:?set OPENNORD to an opennord checkout}\" && python3 -I ../tools/gen_editor_tables.py",
    "gen:editor": "python3 -I ../tools/gen_editor_tables.py"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
